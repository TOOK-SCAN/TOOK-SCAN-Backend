### 8.1.1 (관리자) 약관 추가
//@no-log
POST {{host_url}}/v1/admins/terms
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "type": "{{term.API_8_1_1.type}}",
    "title": "{{term.API_8_1_1.title}}",
    "content": "{{term.API_8_1_1.content}}",
    "is_required": {{term.API_8_1_1.is_required}},
    "is_visible": {{term.API_8_1_1.is_visible}}
}

### 8.2.1 (관리자) 약관 조회
//@no-log
GET {{host_url}}/v1/admins/terms/overviews?type=SCAN
Authorization: Bearer {{access_token}}

### 8.2.2 약관 조회
//@no-log
GET {{host_url}}/v1/users/terms/overviews?type=SIGN_UP
Authorization: Bearer {{access_token}}

### 8.4.1 (관리자) 약관 수정
//@no-log
PUT {{host_url}}/v1/admins/terms
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "terms" : [
    {
      "id": 1,
      "title": "책 재단 및 복원 안내",
      "content": "툭스캔은 서비스 이용을 위해 책을 자르거나 스프링 제본을 하는 과정을 거칩니다. 이 과정에서 페이지 수량에 따라 여러 번의 재단 혹은 약간의 손상이 있을 수 있음을 인지하고 동의합니다.",
      "type": "SIGN_UP",
      "is_required": true,
      "is_visible": true,
      "sort_order": 2
    },
    {
      "id": 2,
      "title": "스캔 주체 및 저작권 법 준수 여부 안내",
      "content": "툭스캔은 비대면 스캔 서비스를 합법적으로 이용할 수 있도록 저작권법을 준수합니다. 저작권법 제 30조에 따라 스캔의 주체는 '본인'이며, 본인 소유의 책만 비대면 스캔 서비스를 이용할 수 있습니다.",
      "type": "SIGN_UP",
      "is_required": true,
      "is_visible": true,
      "sort_order": 1
    },
    {
      "id": 3,
      "title": "불법 유포 금지 안내",
      "content": "제작된 PDF 파일을 저작권자의 동의 없이 제 3자에게 공유, 배포 및 2차 편집을 하지 않겠습니다.",
      "type": "SIGN_UP",
      "is_required": true,
      "is_visible": true,
      "sort_order": 3
    },
    {
      "id": 4,
      "title": "개인정보 수집 및 이용동의",
      "content": "수집목적\n고객 서비스 이용에 관한 안내 및 이용자 식별\n수집항목\n이름, 전화번호, 이메일, (복원할 경우)배송지\n보유기간\n입력일로부터 1년",
      "type": "SIGN_UP",
      "is_required": true,
      "is_visible": true,
      "sort_order": 4
    },
    {
      "id": 5,
      "title": "책 재단 및 복원 안내",
      "content": "툭스캔은 서비스 이용을 위해 책을 자르거나 스프링 제본을 하는 과정을 거칩니다. 이 과정에서 페이지 수량에 따라 여러 번의 재단 혹은 약간의 손상이 있을 수 있음을 인지하고 동의합니다.",
      "type": "SCAN",
      "is_required": true,
      "is_visible": true,
      "sort_order": 2
    },
    {
      "id": 6,
      "title": "스캔 주체 및 저작권 법 준수 여부 안내",
      "content": "툭스캔은 비대면 스캔 서비스를 합법적으로 이용할 수 있도록 저작권법을 준수합니다. 저작권법 제 30조에 따라 스캔의 주체는 '본인'이며, 본인 소유의 책만 비대면 스캔 서비스를 이용할 수 있습니다.",
      "type": "SCAN",
      "is_required": true,
      "is_visible": true,
      "sort_order": 1
    }
  ]
}

### 8.5.1 (관리자) 약관 삭제
//@no-log
DELETE {{host_url}}/v1/admins/terms/1
Authorization: Bearer {{access_token}}
